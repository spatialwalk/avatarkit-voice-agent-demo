# ASR (Deepgram)
# Deepgram Key 获取：https://console.deepgram.com/
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# LLM (OpenAI-compatible)
# OpenAI Key 获取：https://platform.openai.com/api-keys
LLM_API_KEY=your_openai_api_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# TTS (Cartesia)
# Cartesia Key 获取：https://play.cartesia.ai/
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL=sonic-2
CARTESIA_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02

# SpatialReal (Host bridge + session token)
# SpatialReal Key/App ID 获取：https://docs.spatialreal.ai/overview/get-apikeys
# SpatialReal Avatar ID（更多测试人物）获取：https://app.spatialreal.ai/avatars/library
SPATIALREAL_API_KEY=your_spatialreal_api_key
SPATIALREAL_APP_ID=your_spatialreal_app_id
SPATIALREAL_AVATAR_ID=6aed28f9-674c-4ffb-89ee-b447b28aa3ed

# SpatialReal 区域与 Endpoint 参考：https://docs.spatialreal.ai/overview/regions
SPATIALREAL_CONSOLE_ENDPOINT=https://console.spatialreal.ai/v1/console
SPATIALREAL_INGRESS_ENDPOINT=wss://api.spatialreal.ai/v2/driveningress

# 若仅调试 ASR/LLM/TTS，可关掉 Host 帧桥接
HOST_ENABLE_AVATAR_BRIDGE=true

# 本地 UI 调试时可打开 mock token
TOKEN_MOCK_MODE=false
