# ── Server ────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=8765
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── SpatialReal ───────────────────────────────────────────────────
# Get credentials: https://docs.spatialreal.ai/overview/get-apikeys
# Get avatar IDs: https://app.spatialreal.ai/avatars/library
SPATIALREAL_APP_ID=your_spatialreal_app_id
SPATIALREAL_API_KEY=your_spatialreal_api_key
SPATIALREAL_AVATAR_ID=6aed28f9-674c-4ffb-89ee-b447b28aa3ed
SPATIALREAL_ENVIRONMENT=intl

# Region & endpoints: https://docs.spatialreal.ai/overview/regions
SPATIALREAL_CONSOLE_ENDPOINT=https://console.spatialreal.ai/v1/console
SPATIALREAL_INGRESS_ENDPOINT=wss://api.spatialreal.ai/v2/driveningress

AVATAR_OUTPUT_SAMPLE_RATE=16000
USER_INPUT_SAMPLE_RATE=16000

# ── ASR (Deepgram) ───────────────────────────────────────────────
# Get key: https://console.deepgram.com/
ASR_API_KEY=your_asr_api_key
ASR_MODEL=nova-3
ASR_LANGUAGE=en-US
ASR_BASE_URL=https://api.deepgram.com

# ── LLM (OpenAI-compatible) ──────────────────────────────────────
# Works with OpenAI, Doubao, or any OpenAI-compatible provider.
# OpenAI:  https://platform.openai.com/api-keys
# Doubao:  https://console.volcengine.com/ark
LLM_API_KEY=your_llm_api_key
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_SYSTEM_PROMPT=You are a concise and friendly voice assistant.

# ── TTS (Cartesia) ───────────────────────────────────────────────
# Get key: https://play.cartesia.ai/
TTS_API_KEY=your_tts_api_key
TTS_MODEL=sonic-2
TTS_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02
TTS_BASE_URL=https://api.cartesia.ai
