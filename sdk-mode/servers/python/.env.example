# Get SpatialReal App ID / API Key:
# https://docs.spatialreal.ai/overview/get-apikeys
# Get SpatialReal Avatar ID (test avatars):
# https://docs.spatialreal.ai/overview/test-avatars
SPATIALREAL_API_KEY=your_spatialreal_api_key
SPATIALREAL_APP_ID=your_spatialreal_app_id

# SpatialReal region and endpoint guide:
# https://docs.spatialreal.ai/overview/regions
# Default international environment
SPATIALREAL_CONSOLE_ENDPOINT=https://console.spatialreal.ai/v1/console

SESSION_TOKEN_TTL_MINUTES=55
TOKEN_SERVER_PORT=8090

# When true, return mock token without calling SpatialReal
TOKEN_MOCK_MODE=false
