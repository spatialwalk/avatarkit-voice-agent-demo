# Copy this file to local.properties and fill in your credentials.
# https://docs.spatialreal.ai/overview/get-apikeys
# https://docs.spatialreal.ai/overview/test-avatars

SPATIALREAL_APP_ID=your_spatialreal_app_id
SPATIALREAL_AVATAR_ID=your_spatialreal_avatar_id
SPATIALREAL_ENVIRONMENT=intl

# OpenAI (direct calls, demo only)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com
OPENAI_USE_PROXY=false
OPENAI_PROXY_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_STT_LANGUAGE=en
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

# VAD parameters (tune by noise level)
MIC_SAMPLE_RATE=16000
VAD_START_THRESHOLD=0.02
VAD_STOP_THRESHOLD=0.014
VAD_SILENCE_MS=700
VAD_MIN_SPEECH_MS=280
VAD_MAX_SPEECH_MS=30000
