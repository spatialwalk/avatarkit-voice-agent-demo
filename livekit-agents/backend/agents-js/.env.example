# LiveKit Cloud / server credentials
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_api_key
LIVEKIT_API_SECRET=your_api_secret

# SpatialReal avatar credentials
# Get your SpatialReal API credentials at: https://app.spatialreal.ai/
SPATIALREAL_API_KEY=your_key
SPATIALREAL_APP_ID=your_app_id
SPATIALREAL_AVATAR_ID=your_avatar_id

# Deepgram STT
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-US

# OpenAI-compatible LLM
# Use either LLM_API_KEY or OPENAI_API_KEY.
LLM_API_KEY=your_llm_api_key
# OPENAI_API_KEY=your_openai_api_key
# LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Cartesia TTS
CARTESIA_API_KEY=your_cartesia_api_key
CARTESIA_MODEL=sonic-2
CARTESIA_LANGUAGE=en
CARTESIA_VOICE=f786b574-daa5-4673-aa0c-cbe3e8534c02

# Optional agent copy
AGENT_INSTRUCTIONS=You are a helpful voice assistant. Keep responses brief and natural.
INITIAL_GREETING=Hi there! I am your SpatialReal voice assistant. How can I help?

# Optional local token server port
TOKEN_SERVER_PORT=8080
